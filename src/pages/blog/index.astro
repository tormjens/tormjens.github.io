---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(dateStr: string) {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title="Blog" description="Writing about engineering, developer tools, and building things.">
  <Nav />

  <main class="max-w-[1240px] mx-auto px-6 md:px-8 py-12 md:py-16">
    <div class="mb-12">
      <span class="font-mono text-xs uppercase tracking-widest text-fg-faint">// writing</span>
      <h1
        class="section-title font-mono text-fg mt-2"
      >
        All posts
      </h1>
    </div>

    <div class="flex flex-col">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between py-5 border-t border-border hover:pl-2 transition-all duration-200"
          >
            <h2 class="font-mono text-base font-medium text-fg group-hover:text-accent transition-colors duration-120 flex-1 sm:mr-8 leading-snug">
              {post.data.title}
            </h2>
            <time
              class="font-mono text-sm text-fg-faint shrink-0 mt-1 sm:mt-0"
              datetime={post.data.date}
            >
              {formatDate(post.data.date)}
            </time>
          </a>
        ))
      }
      {
        posts.length === 0 && (
          <p class="font-mono text-sm text-fg-faint py-5 border-t border-border">
            No posts yet.
          </p>
        )
      }
      <div class="border-b border-border" />
    </div>
  </main>

  <Footer />
</Base>
