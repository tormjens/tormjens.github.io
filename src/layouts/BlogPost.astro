---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  post: {
    data: {
      title: string;
      date: string;
      categories?: string;
    };
  };
}

const { post } = Astro.props;

const date = new Date(post.data.date + 'T00:00:00');
const formattedDate = date.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categories = post.data.categories?.split(' ') ?? [];
---

<Nav />

<main class="max-w-[720px] mx-auto px-6 md:px-8 py-12 md:py-16">
  <a
    href="/blog"
    class="font-mono text-sm text-fg-faint hover:text-accent transition-colors duration-120 inline-flex items-center gap-2 mb-12"
  >
    ← back to blog
  </a>

  <header class="mt-8 mb-12">
    {
      categories.length > 0 && (
        <div class="flex gap-3 mb-4">
          {categories.map((cat) => (
            <span class="font-mono text-xs uppercase tracking-widest text-accent">{cat}</span>
          ))}
        </div>
      )
    }

    <h1
      class="font-mono text-2xl md:text-4xl font-medium text-fg leading-tight tracking-tight mb-5"
      style="letter-spacing: -0.03em;"
    >
      {post.data.title}
    </h1>

    <time class="font-mono text-sm text-fg-faint" datetime={post.data.date}>
      {formattedDate}
    </time>
  </header>

  <article class="prose font-mono">
    <slot />
  </article>
</main>

<Footer />
