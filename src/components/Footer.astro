---
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-8">
  <div class="max-w-[1240px] mx-auto px-6 md:px-8 py-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <span class="font-mono text-xs text-fg-faint">
        © {year} Tor Morten Jensen
      </span>

      <div class="flex items-center gap-6">
        <a
          href="https://github.com/tormjens"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-fg-faint hover:text-accent transition-colors duration-120"
        >
          github
        </a>
        <a
          href="https://tmj.media"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-fg-faint hover:text-accent transition-colors duration-120"
        >
          tmj.media
        </a>
      </div>
    </div>
  </div>
</footer>
