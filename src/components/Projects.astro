<section class="max-w-[1240px] mx-auto px-6 md:px-8 py-12 md:py-16 border-t border-border">
  <div class="mb-8">
    <span class="font-mono text-xs uppercase tracking-widest text-fg-faint">// projects</span>
    <h2 class="section-title font-mono text-fg mt-2">What I'm building</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <!-- Deck — featured project -->
    <div
      class="accent-left-bar bg-surface border border-border rounded-xl p-7 flex flex-col gap-3 relative overflow-hidden group hover:-translate-y-0.5 hover:border-accent/30 transition-all duration-200"
    >
      <div class="font-mono text-xs text-fg-faint tracking-wider">01</div>

      <div>
        <h3
          class="font-mono text-2xl font-medium text-accent mb-1"
          style="letter-spacing: -0.02em;"
        >
          Deck
        </h3>
        <p class="font-mono text-sm text-fg-dim">Job-class observability for Laravel</p>
      </div>

      <p class="text-sm text-fg-muted leading-relaxed">
        A control plane for Laravel Horizon. Monitor, pause, drain, and resume individual job
        classes across your queues — without touching config files or restarting workers.
      </p>

      <div class="flex flex-wrap gap-2 mt-1">
        <span class="font-mono text-xs px-2 py-1 bg-elevated border border-border rounded text-fg-dim">PHP</span>
        <span class="font-mono text-xs px-2 py-1 bg-elevated border border-border rounded text-fg-dim">Laravel</span>
        <span class="font-mono text-xs px-2 py-1 bg-elevated border border-border rounded text-fg-dim">Redis</span>
        <span class="font-mono text-xs px-2 py-1 bg-elevated border border-border rounded text-fg-dim">Horizon</span>
      </div>

      <div class="flex gap-2 mt-auto pt-2">
        <a
          href="https://deckapp.cloud"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs font-medium px-3 py-1.5 bg-accent text-bg rounded hover:bg-accent-dark transition-all duration-120"
        >
          deckapp.cloud →
        </a>
        <a
          href="https://github.com/tormjens/deck"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs px-3 py-1.5 bg-elevated text-fg-dim border border-border-strong rounded hover:text-fg transition-all duration-120"
        >
          github
        </a>
      </div>
    </div>

    <!-- Placeholder -->
    <div
      class="bg-surface border border-border border-dashed rounded-xl p-7 flex flex-col justify-center items-start gap-2"
      style="opacity: 0.25;"
    >
      <div class="font-mono text-xs text-fg-faint tracking-wider">02</div>
      <div class="font-mono text-sm text-fg-faint mt-1">// next project tbd</div>
    </div>
  </div>
</section>
